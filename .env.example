# Agentpress config

# Copy to .env (gitignored) and edit as needed:
#   cp .env.example .env

# Database
# - Default (no Docker): SQLite file at ./backend/.data/agentpress.db
# - Docker compose: Postgres is set via AGENTPRESS_DATABASE_URL in docker-compose.yml

# Migrations
# - For Postgres/production, prefer migrations over create_all.
# - If you enable run-migrations on startup, do not point at an existing DB that was
#   previously created via create_all unless you've stamped/migrated it.
# AGENTPRESS_RUN_MIGRATIONS_ON_STARTUP=true
# AGENTPRESS_AUTO_CREATE_TABLES=false

# Optional API key (recommended for self-host; enables auth on /agents, /plugins, /audit)
# AGENTPRESS_API_KEY=change-me

# Optional JWT auth (for browser clients + OAuth logins)
# If set, and no API key is provided, protected endpoints require `Authorization: Bearer <jwt>`.
# AGENTPRESS_JWT_SECRET=change-me
# AGENTPRESS_JWT_ALGORITHM=HS256
# AGENTPRESS_JWT_ACCESS_TOKEN_MINUTES=60
# AGENTPRESS_JWT_ISSUER=agentpress
# AGENTPRESS_JWT_AUDIENCE=agentpress

# Optional: store JWT in an HttpOnly cookie (for browser clients)
# If enabled, the backend will also accept the cookie token when no Authorization header is present.
# AGENTPRESS_AUTH_COOKIE_ENABLED=false
# AGENTPRESS_AUTH_COOKIE_NAME=agentpress_access_token
# AGENTPRESS_AUTH_COOKIE_SAMESITE=lax
# AGENTPRESS_AUTH_COOKIE_DOMAIN=
# AGENTPRESS_AUTH_COOKIE_PATH=/

# Optional: after OAuth callback, redirect to this URL instead of returning JSON
# (useful when combined with cookie auth)
# AGENTPRESS_AUTH_REDIRECT_SUCCESS_URL=
# AGENTPRESS_AUTH_REDIRECT_ERROR_URL=

# Optional OAuth (Authorization Code)
# Configure one or both providers. Redirect URIs must match what you set in the provider console.
# Optional PKCE (extra hardening; keep false unless you know your provider/app supports it)
# AGENTPRESS_OAUTH_PKCE_ENABLED=false
#
# Google:
# AGENTPRESS_GOOGLE_OAUTH_CLIENT_ID=
# AGENTPRESS_GOOGLE_OAUTH_CLIENT_SECRET=
# AGENTPRESS_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
#
# GitHub:
# AGENTPRESS_GITHUB_OAUTH_CLIENT_ID=
# AGENTPRESS_GITHUB_OAUTH_CLIENT_SECRET=
# AGENTPRESS_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/github/callback

# LLM (free-by-default)
AGENTPRESS_LLM_PROVIDER=ollama
# If using docker compose profile "ollama":
#   http://ollama:11434 (from the backend container)
# If using native Ollama on your host:
#   http://localhost:11434 (backend running on host)
#   http://host.docker.internal:11434 (backend running in Docker on Windows/Mac)
AGENTPRESS_OLLAMA_BASE_URL=http://localhost:11434
AGENTPRESS_OLLAMA_MODEL=llama3

# Optional: external providers (BYO keys)
# AGENTPRESS_LLM_PROVIDER=openai
# AGENTPRESS_OPENAI_API_KEY=

# AGENTPRESS_LLM_PROVIDER=anthropic
# AGENTPRESS_ANTHROPIC_API_KEY=

# Embeddings (free local)
AGENTPRESS_EMBEDDINGS_PROVIDER=sentence-transformers
AGENTPRESS_EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Tool calling
# - manual: enable /tool directive (works with any model)
# - auto: LLM-driven tool calling via TOOL_CALL/TOOL_RESULT protocol
# - disabled: no tool execution
AGENTPRESS_TOOL_CALLING_MODE=manual

# HTTP hardening (recommended defaults)
AGENTPRESS_RATE_LIMIT_ENABLED=true
AGENTPRESS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AGENTPRESS_MAX_REQUEST_BODY_BYTES=1000000
AGENTPRESS_TRUST_PROXY_HEADERS=false

AGENTPRESS_SECURITY_HEADERS_ENABLED=true
AGENTPRESS_HSTS_ENABLED=false
AGENTPRESS_HSTS_MAX_AGE_SECONDS=31536000

# Disable docs endpoints in production
AGENTPRESS_ENABLE_DOCS=true

# CORS (disabled by default)
AGENTPRESS_CORS_ENABLED=false
# AGENTPRESS_CORS_ALLOW_ORIGINS=["https://your-frontend.example.com"]

# Audit (in-memory)
AGENTPRESS_AUDIT_ENABLED=true
AGENTPRESS_AUDIT_MAX_EVENTS=2000

# /health dependency checks (optional)
# If set, /health will validate connectivity and may return status=degraded.
# AGENTPRESS_REDIS_URL=redis://localhost:6379
# AGENTPRESS_QDRANT_URL=http://localhost:6333
AGENTPRESS_HEALTHCHECK_TIMEOUT_SECONDS=1.5
