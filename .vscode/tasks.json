{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:backend",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/dev.ps1"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev:frontend",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev:all",
      "dependsOn": ["dev:backend", "dev:frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
