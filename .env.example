# Agentpress config

# Database
# - Default (no Docker): SQLite file at ./backend/.data/agentpress.db
# - Docker compose: Postgres is set via AGENTPRESS_DATABASE_URL in docker-compose.yml

# LLM (free-by-default)
AGENTPRESS_LLM_PROVIDER=ollama
# If using docker compose profile "ollama":
#   http://ollama:11434 (from the backend container)
# If using native Ollama on your host:
#   http://localhost:11434 (backend running on host)
#   http://host.docker.internal:11434 (backend running in Docker on Windows/Mac)
AGENTPRESS_OLLAMA_BASE_URL=http://localhost:11434
AGENTPRESS_OLLAMA_MODEL=llama3

# Optional: external providers (BYO keys)
# AGENTPRESS_LLM_PROVIDER=openai
# AGENTPRESS_OPENAI_API_KEY=

# AGENTPRESS_LLM_PROVIDER=anthropic
# AGENTPRESS_ANTHROPIC_API_KEY=

# Embeddings (free local)
AGENTPRESS_EMBEDDINGS_PROVIDER=sentence-transformers
AGENTPRESS_EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Tool calling
# - manual: enable /tool directive (works with any model)
# - auto: LLM-driven tool calling via TOOL_CALL/TOOL_RESULT protocol
# - disabled: no tool execution
AGENTPRESS_TOOL_CALLING_MODE=manual
